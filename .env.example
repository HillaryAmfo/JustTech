# ---------------------------------------------------------------------------
# JustTech — environment variable reference
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is ignored by git and never committed.
#
# All variables are optional. Without a `.env` file the project runs in a
# safe, local-development configuration by default.
# ---------------------------------------------------------------------------

# SECURITY WARNING: never use the built-in dev fallback in production.
# Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Must be false (or unset-with-value false) when deployed.
# true = local development server.
DJANGO_DEBUG=true

# Comma-separated allowed Host headers, e.g.:
#   justtech.example,www.justtech.example
# Default (development): localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins allowed to POST forms (CSRF), e.g.:
#   https://justtech.example
# Required only once the site is served over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Enable HTTPS-only hardening (secure cookies, SSL redirect, HSTS).
# Set to true ONLY when the site is served over HTTPS in production.
DJANGO_HTTPS=false

# Optional production database URL. Default is SQLite (db.sqlite3).
# NOTE: the matching driver must be added to requirements.txt first.
#   PostgreSQL: postgresql://user:password@host:5432/justtech
#   SQLite:     sqlite:///C:/path/to/db.sqlite3
DJANGO_DATABASE_URL=

# Canonical site URL used for <link rel="canonical"> and Open Graph tags,
# e.g. https://justtech.example. Leave unset in development (the request host
# is used automatically).
SITE_URL=